# CRYPTOBOT environment template.
# Copy to `.env` locally and fill in real values. NEVER commit `.env`.
# Never paste these values into chat, tickets, or logs.
#
# The application reads these variable names only. It never loads a .env file
# itself (no dotenv dependency); export them in your shell, or use the
# provided `cryptobot env-hint` command for platform-specific syntax.

# --- Alpaca PAPER account keys (required only for `cryptobot paper-run`) -----
# Generate at: https://app.alpaca.markets/paper/dashboard/overview
# Paper keys only. Live keys are neither required nor supported by this project.
ALPACA_API_KEY=replace_me_paper_key_id
ALPACA_API_SECRET_KEY=replace_me_paper_secret_key

# --- Telegram notifications (optional) --------------------------------------
CRYPTOBOT_TELEGRAM_BOT_TOKEN=replace_me
CRYPTOBOT_TELEGRAM_CHAT_ID=replace_me

# --- Optional path override -------------------------------------------------
# CRYPTOBOT_DB=var/cryptobot.db
